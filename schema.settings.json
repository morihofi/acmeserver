{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "dnsName": {
          "type": "string"
        },
        "ports": {
          "type": "object",
          "properties": {
            "https": {
              "type": "integer"
            },
            "http": {
              "type": "integer"
            }
          },
          "required": [
            "https",
            "http"
          ]
        },
        "loggingDirectory": {
          "type": "string"
        },
        "mozillaSslConfig": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "version": {
              "type": "string"
            },
            "configuration": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "version",
            "configuration"
          ]
        },
        "sslServerConfig": {
          "type": "object",
          "properties": {
            "allowLegacyResumption": {
              "type": "boolean"
            },
            "enableSniCheck": {
              "type": "boolean"
            }
          },
          "required": [
            "allowLegacyResumption",
            "enableSniCheck"
          ]
        }
      },
      "required": [
        "dnsName",
        "ports",
        "loggingDirectory",
        "mozillaSslConfig",
        "sslServerConfig"
      ]
    },
    "keyStore": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "libraryLocation": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "password"
      ]
    },
    "database": {
      "type": "object",
      "properties": {
        "jdbcUrl": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "jdbcUrl",
        "user",
        "password"
      ]
    },
    "network": {
      "type": "object",
      "properties": {
        "proxy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "type": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            },
            "authentication": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": [
                "enabled",
                "username",
                "password"
              ]
            }
          },
          "required": [
            "enabled",
            "type",
            "host",
            "port",
            "authentication"
          ]
        },
        "dnsConfig": {
          "type": "object",
          "properties": {
            "dnsServers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dohEnabled": {
              "type": "boolean"
            },
            "dohEndpoint": {
              "type": "string"
            }
          },
          "required": [
            "dohEnabled",
            "dohEndpoint",
            "dnsServers"
          ]
        }
      },
      "required": [
        "proxy",
        "dnsConfig"
      ]
    }
    ,
    "grpc": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "port": {"type": "integer"}
      },
      "required": ["enabled", "host", "port"]
    }
  },
  "required": [
    "server",
    "keyStore",
    "database",
    "network"
  ]
}
