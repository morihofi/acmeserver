{
  "$schema": "schema.settings.json",
  "server": {
    "dnsName": "acme.example.com",
    "ports": {
      "https": 443,
      "http": 80
    },
    "loggingDirectory": "./serverdata/logs",
    "mozillaSslConfig": {
      "enabled": false,
      "version": "5.7",
      "configuration": "intermediate"
    },
    "sslServerConfig": {
      "allowLegacyResumption": false,
      "enableSniCheck": true
    }
  },
  "keyStore": {
    "type": "pkcs12",
    "password": "CHANGE_ME",
    "location": "./serverdata/test.p12"
  },
  "database": {
    "jdbcUrl": "jdbc:h2:./serverdata/acme;DB_CLOSE_DELAY=-1",
    "user": "root",
    "password": "CHANGE_ME"
  },
  "network": {
    "proxy": {
      "enabled": false,
      "type": "socks",
      "host": "127.0.0.1",
      "port": 9050,
      "authentication": {
        "enabled": false,
        "username": "username",
        "password": "password"
      }
    },
    "dnsConfig": {
      "dnsServers": [
        "8.8.8.8",
        "8.8.4.4",
        "2001:4860:4860::8888",
        "2001:4860:4860::8844"
      ],
      "dohEnabled": false,
      "dohEndpoint": "https://cloudflare-dns.com/dns-query"
    }
  },
  "grpc": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 50051
  }
}
