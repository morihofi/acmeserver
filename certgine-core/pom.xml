        <dependency>
            <groupId>de.morihofi.certgine</groupId>
            <artifactId>certgine-mod-acme</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>de.morihofi.certgine</groupId>
            <artifactId>certgine-mod-web-ui</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>de.morihofi.certgine</groupId>
            <artifactId>certgine-mod-web-legacy</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>de.morihofi.certgine</groupId>
            <artifactId>certgine-mod-revocation</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>de.morihofi.certgine</groupId>
            <artifactId>certgine-mod-tsa</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

</project>